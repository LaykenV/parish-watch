{
  "name": "public-parish",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=11 <12"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "convex dev --start 'vite dev --port 3000'",
    "dev:web": "vite dev --port 3000",
    "dev:convex": "convex dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build && npm run lint",
    "hosting:smoke:dev": "npx @convex-dev/static-hosting upload --build --dist dist/client",
    "analytics:report:production": "npx convex run --prod analytics/report:summary '{}'",
    "smoke:production": "node scripts/smoke-production.mjs && npx convex run --prod system/status:readiness '{}'",
    "deploy": "npx @convex-dev/static-hosting deploy --dist dist/client"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@convex-dev/auth": "2.0.0-alpha.1",
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/react-query": "0.1.0",
    "@convex-dev/static-hosting": "0.2.1",
    "@convex-dev/workflow": "0.4.6",
    "@firecrawl/firecrawl-convex": "0.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query": "5.102.7",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.49",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.45.0",
    "convex-helpers": "0.1.123",
    "lucide-react": "0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.3.3",
    "vgpu": "0.3.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "1.167.33",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@webgpu/types": "0.1.69",
    "convex-test": "0.0.56",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
